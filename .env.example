# Application
NODE_ENV=production
APP_PORT=3000

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cheapest

# For Docker Compose
# Uncomment these when using docker-compose
# DB_HOST=postgres
# DB_USERNAME=postgres

# Load testing (Lab 2)
# Name of the load-seed YAML to use, resolved from src/datasources/ (or dist/datasources/ in prod).
# Switch between scenarios without editing load-seed.yaml:
#   LOAD_SEED_FILE=load-seed-get.yaml
#   LOAD_SEED_FILE=load-seed-post.yaml
LOAD_SEED_FILE=load-seed.yaml
